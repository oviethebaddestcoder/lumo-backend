# --- shared (usually from the lumo-common ConfigMap/Secret) ---
LOG_LEVEL=info
ADDR=:8080
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_MECHANISM=            # SCRAM-SHA-512 for managed Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ADDRS=             # host:port,host:port for Redis Cluster
REDIS_PASSWORD=                  # Cluster only (a single node takes it in REDIS_URL)
REDIS_TLS=false                  # Cluster only: true for managed clusters
JWKS_URL=http://svc-identity/.well-known/jwks.json
IDENTITY_URL=http://svc-identity

# --- svc-wallet ---
# One DSN for everything, or ranges over the 4096 logical shards:
SHARDS=postgresql://...-pooler.../wallet?sslmode=require
# SHARDS=0-2047=postgresql://a-pooler...;2048-4095=postgresql://b-pooler...
SHARDS_DIRECT=postgresql://.../wallet?sslmode=require
LOGICAL_SHARDS=4096                      # never change after launch
ACCOUNT_TAG_SECRET=BASE64_32_BYTES
DIAMONDS_PER_100_COINS=50
MIN_PAYOUT_DIAMONDS=10000
# Naira paid per diamond on cash-out, in kobo (50 = ₦0.50). Set with finance before launch.
PAYOUT_KOBO_PER_DIAMOND=          # REQUIRED with Paystack. Creator share = this × DIAMONDS_PER_100_COINS/100 ÷ coin price (kobo). At ₦20/coin, 2000 gives creators 50%; 50 gives them 1.25%.
GOOGLE_PLAY_PACKAGE=app.lumo
GOOGLE_PLAY_SERVICE_ACCOUNT=BASE64_JSON
APPLE_BUNDLE_ID=app.lumo.ios
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_KEY_P8=BASE64_P8
APPLE_IAP_SANDBOX=false
PAYSTACK_SECRET_KEY=
