# --- shared (usually from the lumo-common ConfigMap/Secret) ---
LOG_LEVEL=info
ADDR=:8080
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_MECHANISM=            # SCRAM-SHA-512 for managed Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ADDRS=             # host:port,host:port for Redis Cluster
REDIS_PASSWORD=                  # Cluster only (a single node takes it in REDIS_URL)
REDIS_TLS=false                  # Cluster only: true for managed clusters
JWKS_URL=http://svc-identity/.well-known/jwks.json
IDENTITY_URL=http://svc-identity

# --- svc-social ---
# Neon: use the POOLED string for the app, the DIRECT string for migrations.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/social?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/social?sslmode=require
INTERNAL_TOKEN=CHANGE_ME_SHARED_WITH_FEED_AND_NOTIFIER
