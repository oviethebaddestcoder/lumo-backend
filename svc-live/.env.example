# --- shared (usually from the lumo-common ConfigMap/Secret) ---
LOG_LEVEL=info
ADDR=:8080
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_MECHANISM=            # SCRAM-SHA-512 for managed Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ADDRS=             # host:port,host:port for Redis Cluster
JWKS_URL=http://svc-identity/.well-known/jwks.json
IDENTITY_URL=http://svc-identity

# --- svc-live ---
# Neon: use the POOLED string for the app, the DIRECT string for migrations.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/live?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/live?sslmode=require
LIVEKIT_WS_URL=wss://live.yourdomain
LIVEKIT_API_URL=https://live.yourdomain
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EGRESS_S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
EGRESS_S3_BUCKET=lumo-media
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
HLS_BASE_URL=https://cdn.yourdomain
HLS_VIEWER_THRESHOLD=300
PK_DURATION=5m
