# --- shared (usually from the lumo-common ConfigMap/Secret) ---
LOG_LEVEL=info
ADDR=:8080
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_MECHANISM=            # SCRAM-SHA-512 for managed Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ADDRS=             # host:port,host:port for Redis Cluster
JWKS_URL=http://svc-identity/.well-known/jwks.json
IDENTITY_URL=http://svc-identity

# --- svc-identity ---
# Neon: use the POOLED string for the app, the DIRECT string for migrations.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/identity?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/identity?sslmode=require
SIGNING_KEYS=k1:BASE64_OF_PEM          # first key signs; add old keys after it to rotate (lumo-infra/scripts/gen-secrets.sh)
OTP_HMAC_SECRET=BASE64_32_BYTES
OTP_PER_IP_PER_HOUR=200                  # shared carrier IPs (CGNAT) need headroom; per-number limits still apply
OTP_TEST_ACCOUNTS=+2348000000001=123456   # for App Store / Play review only
PHONE_DEFAULT_REGION=NG
SMS_PROVIDER=log                         # termii | twilio | log (dev only)
TERMII_API_KEY=
TERMII_SENDER_ID=Lumo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=log                       # resend | log
RESEND_API_KEY=
EMAIL_FROM=Lumo <no-reply@yourdomain>
GOOGLE_CLIENT_IDS=ios-client-id,android-client-id,web-client-id
APPLE_CLIENT_IDS=app.lumo.ios,app.lumo.web
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_IDS=                        # for iOS Limited Login tokens
X_CLIENT_ID=
X_CLIENT_SECRET=
LINE_CHANNEL_IDS=
KAKAO_APP_KEYS=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
