# --- shared (usually from the lumo-common ConfigMap/Secret) ---
LOG_LEVEL=info
ADDR=:8080
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_MECHANISM=            # SCRAM-SHA-512 for managed Kafka
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ADDRS=             # host:port,host:port for Redis Cluster
JWKS_URL=http://svc-identity/.well-known/jwks.json
IDENTITY_URL=http://svc-identity

# --- svc-feed ---
SOCIAL_URL=http://svc-social
INTERNAL_TOKEN=CHANGE_ME

# Ranking formula overrides (JSON; unset fields keep defaults) and A/B test.
# RANK_WEIGHTS={"tag":1.0,"author":1.2,"follow":0.5,"co":0.8,"quality":1.5,"fresh":0.35,"trending":0.3,"explore":0.25,"jitter":0.05,"same_author":0.6,"same_tag":0.15,"explore_every":5}
RANK_WEIGHTS=
RANK_B_WEIGHTS=
RANK_B_PERCENT=0
